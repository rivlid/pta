#proxmox
PROXMOX_PASSWORD=pass
PROXMOX_NODE=f01-hv01
PROXMOX_HOST=https://192.168.0.1:8006
PROXMOX_USERNAME=root@pam
#vm
VM_COUNT=1
VM_ID=20001
VM_NAME=f99-db
# сдвиг номера: 4 -> первая ВМ будет f99-db05
NAME_OFFSET=0
VM_CORES=4
VM_MEMORY=8192
VM_TAGS=["deb","db","firebird"]
STORAGE_POOL=zfs-ssd
#disks (GB)
VM_DISK_SIZE=32
SWAP_DISK_SIZE=5
DATA_DISK_SIZE=750
# пул под диск с базами, пусто = STORAGE_POOL
DATA_STORAGE_POOL=
#network vm
VLAN_ID=9
DNS_DOMAIN=sadkomed.local
DHCP=false
IP_ADDRESS=192.168.9.100/24
IP_GATEWAY=192.168.9.254
